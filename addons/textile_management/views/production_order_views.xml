<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- list views -->
    <record id="view_textile_production_list" model="ir.ui.view">
        <field name="name">textile.production.list</field>
        <field name="model">textile.production</field>
        <field name="arch" type="xml">
            <list string="Production Orders">
                <field name="name"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="production_date"/>
                <field name="deadline"/>
                <field name="responsible_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- form view -->
    <record id="view_textile_production_form" model="ir.ui.view">
        <field name="name">textile.production.form</field>
        <field name="model">textile.production</field>
        <field name="arch" type="xml">
            <form string="Production Order">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="production_date"/>
                        </group>
                        <group>
                            <field name="deadline"/>
                            <field name="responsible_id"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_textile_production" model="ir.actions.act_window">
        <field name="name">Production Orders</field>
        <field name="res_model">textile.production</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_textile_management"
        name="Textile Management"
        sequence="10"
    />

    <menuitem
        id="menu_textile_production"
        name="Production Orders"
        parent="menu_textile_management"
        action="action_textile_production"
        sequence="10"
    />
</odoo>